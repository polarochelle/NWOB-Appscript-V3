 <script>
 const rawData = window.APP_DATA || {};
 let activeDashboardData = {};

 const fmt0 = value => new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(Number(value || 0));
 const fmt2 = value => new Intl.NumberFormat('en-US', { maximumFractionDigits: 2 }).format(Number(value || 0));
 const fmtAllocation = value => {
   const number = Number(value || 0);
   return Number.isInteger(number) ? fmt0(number) : number.toFixed(2);
 };

 const esc = value => String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');

 function clean(value) { return value === null || value === undefined ? '' : String(value).trim(); }
 function normalize(value) { return clean(value).toLowerCase().replace(/\s+/g, ' ').trim(); }
 function normalizeRole(value) { return normalize(value).replace(/assurrance/g, 'assurance'); }
 function isTBD(value) { return normalize(value).indexOf('tbd') !== -1; }

 function roundHalfUp(value) {
   const num = Number(value || 0);
   const decimal = num % 1;
   if (decimal >= 0.5) {
     return Math.ceil(num);
   }
   return Math.floor(num);
 }

 function getEffectiveRole(roleL, roleH) {
   const nwob = clean(roleL);
   const source = clean(roleH);
   const normNwob = normalizeRole(nwob);

   if (!nwob || normNwob === 'others' || normNwob === 'other') {
     return source || 'Role not specified';
   }

   if (normNwob === 'chapter lead' && source) {
     return normalize(source).indexOf('chapter lead') !== -1 ? source : 'Chapter Lead - ' + source;
   }

   return nwob;
 }

 function round2(value) { return Math.round(value * 100) / 100; }

 function roleRank(value) {
   const role = normalizeRole(value);
   
   if (role.indexOf('chapter lead') !== -1 || role.indexOf('chap lead') !== -1) return 0;
   
   if (role === 'solutions designer' || role.indexOf('solutions designer') !== -1) return 1;
   if (role === 'quality assurance lead' || role.indexOf('quality assurance') !== -1) return 2;
   if (role === 'scrum master' || role.indexOf('scrum master') !== -1) return 3;
   if (role.indexOf('data engineer') !== -1 || role.indexOf('uipath') !== -1) return 4;
   if (role === 'lead builder') return 5;
   if (role === 'builder') return 6;
   
   return 7;
 }

 function buildCustomMultiselect(containerId, options, defaultLabel, onChangeCallback) {
   const container = document.getElementById(containerId);
   if (!container) return;

   const dropdown = container.querySelector('.checkboxes-dropdown');
   const textSpan = container.querySelector('.select-box .text');

   let selected = [];

   function renderDropdown() {
     dropdown.innerHTML = options.map((opt) => {
       const checked = selected.includes(opt.value) ? 'checked' : '';
       return `
         <label class="checkbox-option">
           <input type="checkbox" value="${esc(opt.value)}" ${checked}>
           <span>${esc(opt.label)}</span>
         </label>
       `;
     }).join('');

     dropdown.querySelectorAll('input[type="checkbox"]').forEach(chk => {
       chk.addEventListener('change', (e) => {
         const val = e.target.value;
         if (e.target.checked) {
           if (!selected.includes(val)) selected.push(val);
         } else {
           selected = selected.filter(v => v !== val);
         }
         updateLabel();
         onChangeCallback(selected);
       });
     });
   }

   function updateLabel() {
     if (selected.length === 0) {
       textSpan.textContent = defaultLabel;
     } else if (selected.length === 1) {
       const found = options.find(o => o.value === selected[0]);
       textSpan.textContent = found ? found.label : selected[0];
     } else {
       textSpan.textContent = `${selected.length} Selected`;
     }
   }

   container.querySelector('.select-box').addEventListener('click', (e) => {
     e.stopPropagation();
     document.querySelectorAll('.custom-multiselect').forEach(el => {
       if (el !== container) el.classList.remove('open');
     });
     container.classList.toggle('open');
   });

   renderDropdown();
   updateLabel();

   return {
     getSelected: () => selected,
     setSelected: (vals) => { selected = vals; renderDropdown(); updateLabel(); },
     updateOptions: (newOpts) => { options = newOpts; selected = []; renderDropdown(); updateLabel(); }
   };
 }

 function matchesFilter(selectedValues, rowValue) {
   if (!selectedValues || selectedValues.length === 0) return true;
   return selectedValues.includes(rowValue);
 }

 function processData(selectedTribes, selectedPods, selectedRoles, selectedChapLeads, selectedNwobTypes) {
   const rows = [];
   const headcountRows = [];
   const resourceAssignments = [];
   const forHireByRole = {};

   let allocationTotal = 0;
   let forHireTotal = 0;

   let totalOrg = 0;
   let totalInorg = 0;
   let activeOrg = 0;
   let activeInorg = 0;
   let forHireOrg = 0;
   let forHireInorg = 0;

   let totalLeadBuilders = 0;
   let totalBuilders = 0;

   (rawData.rawRows || []).forEach(row => {
     const catQ = clean(row.categoryQ);
     let nwobType = 'Others';
     if (normalize(catQ) === 'pod') nwobType = 'POD';
     else if (normalize(catQ) === 'bau') nwobType = 'BAU';

     if (!matchesFilter(selectedTribes, row.tribe)) return;
     if (!matchesFilter(selectedPods, row.pod)) return;
     if (!matchesFilter(selectedChapLeads, row.aeChapLeadR)) return;
     if (!matchesFilter(selectedNwobTypes, nwobType)) return;

     const effectiveRole = getEffectiveRole(row.roleL, row.roleH);
     if (selectedRoles && selectedRoles.length > 0) {
       const roleMatch = selectedRoles.some(r => r === effectiveRole || r === row.roleL || r === row.roleH);
       if (!roleMatch) return;
     }

     const tribe = row.tribe;
     const pod = row.pod;
     const resource = row.resource;
     const allocation = row.allocation;
     const roleH = row.roleH;
     const roleL = row.roleL;
     const empType = clean(row.empType);
     const isOrganic = normalize(empType) === 'organic';

     const normRoleL = normalizeRole(roleL);
     if (normRoleL === 'lead builder') totalLeadBuilders += allocation;
     if (normRoleL === 'builder') totalBuilders += allocation;

     allocationTotal += allocation;
     if (isOrganic) totalOrg += allocation;
     else totalInorg += allocation;

     if (isTBD(resource)) {
       forHireTotal += allocation;
       if (isOrganic) forHireOrg += allocation;
       else forHireInorg += allocation;

       const role = effectiveRole || 'Role not tagged';

       if (!forHireByRole[role]) {
         forHireByRole[role] = { headcount: 0, pods: {} };
       }
       forHireByRole[role].headcount += allocation;
       if (pod && pod !== '-') {
         forHireByRole[role].pods[pod] = true;
       }
     } else {
       if (isOrganic) activeOrg += allocation;
       else activeInorg += allocation;
     }

     headcountRows.push({ tribe, pod, resource, allocation, role_h: roleH, role_l: roleL, effective_role: effectiveRole, empType });
     resourceAssignments.push({ tribe, resource, role: effectiveRole, pod: pod || '—', allocation, empType });

     if (pod && pod !== '-') {
       rows.push({ tribe, pod, resource, allocation, role_h: roleH, role_l: roleL, effective_role: effectiveRole, categoryQ: row.categoryQ, aeChapLeadR: row.aeChapLeadR, empType });
     }
   });

   const podRowsOnly = rows.filter(r => normalize(r.categoryQ) === 'pod' || normalize(r.categoryQ) !== 'bau');
   const podMap = {};
   podRowsOnly.forEach(row => {
     const key = row.tribe + '|||' + row.pod;
     if (!podMap[key]) {
       podMap[key] = { tribe: row.tribe, pod: row.pod, assignments: [] };
     }
     podMap[key].assignments.push(row);
   });

   const requiredRoles = ['solutions designer', 'quality assurance lead', 'scrum master', 'lead builder', 'builder'];
   const scorecardRoles = [
     ['Solutions Designer', 'solutions designer'],
     ['Quality Assurance Lead', 'quality assurance lead'],
     ['Scrum Master', 'scrum master'],
     ['Lead Builder', 'lead builder'],
     ['Builder', 'builder']
   ];

   function podIsComplete(assignments, podName) {
     const noTBD = assignments.every(row => !isTBD(row.resource));
     const requiredRolesHaveAllocation = requiredRoles.every(role =>
       assignments.some(row => normalizeRole(row.role_l) === role && row.allocation > 0)
     );
     const leadBuilderCount = assignments.filter(row => normalizeRole(row.role_l) === 'lead builder' && row.allocation > 0).length;
     const builderCount = assignments.filter(row => normalizeRole(row.role_l) === 'builder' && row.allocation > 0).length;
     const builderRule = normalize(podName).indexOf('gbox') !== -1 ? builderCount <= 2 : builderCount === 2;
     return noTBD && requiredRolesHaveAllocation && leadBuilderCount === 1 && builderRule;
   }

   const podCards = Object.keys(podMap)
     .sort((a, b) => podMap[a].pod.localeCompare(podMap[b].pod))
     .map(key => {
       const pod = podMap[key];
       const assignments = pod.assignments;

       const roleScorecard = scorecardRoles.map(item => ({
         role: item[0],
         allocation: round2(
           assignments.filter(row => normalizeRole(row.role_l) === item[1] && !isTBD(row.resource))
                      .reduce((sum, row) => sum + row.allocation, 0)
         )
       }));

       // FILTER OUT PRODUCT OWNER FROM POD ASSIGNMENT CARDS
       const filteredAssignments = assignments.filter(row => 
         normalize(row.effective_role) !== 'product owner' && 
         normalize(row.role_l) !== 'product owner' && 
         normalize(row.role_h) !== 'product owner'
       );

       const sortedAssignments = filteredAssignments.slice().sort((a, b) =>
         roleRank(a.role_l) - roleRank(b.role_l) ||
         a.effective_role.localeCompare(b.effective_role) ||
         a.resource.localeCompare(b.resource)
       );

       return {
         id: normalize(pod.tribe + '-' + pod.pod).replace(/[^a-z0-9]+/g, '-'),
         tribe: pod.tribe,
         pod: pod.pod,
         lead_builder: assignments.filter(row => normalizeRole(row.role_l) === 'lead builder').length,
         builder: assignments.filter(row => normalizeRole(row.role_l) === 'builder').length,
         total_assignments: sortedAssignments.length,
         target_met: podIsComplete(assignments, pod.pod),
         role_scorecard: roleScorecard,
         assignments: sortedAssignments.map(row => ({
           resource: row.resource,
           role_l: row.effective_role,
           role_h: row.role_h || 'Role not specified',
           allocation: row.allocation,
           empType: row.empType
         }))
       };
     });

   const bauRows = (rawData.rawRows || []).filter(row => {
     const isBau = normalize(row.categoryQ) === 'bau';
     if (!isBau) return false;

     if (!matchesFilter(selectedTribes, row.tribe)) return false;
     if (!matchesFilter(selectedPods, row.pod)) return false;
     if (!matchesFilter(selectedChapLeads, row.aeChapLeadR)) return false;

     const effectiveRole = getEffectiveRole(row.roleL, row.roleH);
     if (selectedRoles && selectedRoles.length > 0) {
       const roleMatch = selectedRoles.some(r => r === effectiveRole || r === row.roleL || r === row.roleH);
       if (!roleMatch) return false;
     }

     return true;
   });

   const bauMap = {};
   bauRows.forEach(row => {
     if (!row.pod || row.pod === '-') return;
     const key = row.tribe + '|||' + row.pod;
     if (!bauMap[key]) {
       bauMap[key] = { tribe: row.tribe, pod: row.pod, assignments: [] };
     }
     bauMap[key].assignments.push(row);
   });

   function bauIsComplete(assignments) {
     const noTBD = assignments.every(row => !isTBD(row.resource));
     const hasSD = assignments.some(r => normalize(r.roleH).includes('solutions designer') && r.allocation > 0);
     const hasQA = assignments.some(r => normalize(r.roleH).includes('quality assurance') && r.allocation > 0);
     const hasSM = assignments.some(r => normalize(r.roleH).includes('scrum master') && r.allocation > 0);
     const hasDevDataOrUiPath = assignments.some(r => {
       const roleNorm = normalize(r.roleH);
       return (roleNorm.includes('developer') || roleNorm.includes('data engineer') || roleNorm.includes('uipath')) && r.allocation > 0;
     });
     return noTBD && hasSD && hasQA && hasSM && hasDevDataOrUiPath;
   }

   const bauCards = Object.keys(bauMap)
     .sort((a, b) => bauMap[a].pod.localeCompare(bauMap[b].pod))
     .map(key => {
       const item = bauMap[key];
       const assignments = item.assignments;

       // FILTER OUT PRODUCT OWNER FROM BAU ASSIGNMENT CARDS
       const filteredAssignments = assignments.filter(row => 
         normalize(getEffectiveRole(row.roleL, row.roleH)) !== 'product owner' && 
         normalize(row.roleL) !== 'product owner' && 
         normalize(row.roleH) !== 'product owner'
       );

       const sortedAssignments = filteredAssignments.slice().sort((a, b) => {
         const effA = getEffectiveRole(a.roleL, a.roleH);
         const effB = getEffectiveRole(b.roleL, b.roleH);
         return roleRank(effA) - roleRank(effB) || effA.localeCompare(effB) || a.resource.localeCompare(b.resource);
       });

       return {
         id: normalize(item.tribe + '-' + item.pod + '-bau').replace(/[^a-z0-9]+/g, '-'),
         tribe: item.tribe,
         pod: item.pod,
         target_met: bauIsComplete(assignments),
         assignments: sortedAssignments.map(row => ({
           resource: row.resource,
           role_h: getEffectiveRole(row.roleL, row.roleH),
           allocation: row.allocation,
           empType: row.empType
         }))
       };
     });

   const podCategoryMap = {};
   (rawData.rawRows || []).forEach(row => {
     const catQ = clean(row.categoryQ);
     let nwobType = 'Others';
     if (normalize(catQ) === 'pod') nwobType = 'POD';
     else if (normalize(catQ) === 'bau') nwobType = 'BAU';

     if (!matchesFilter(selectedTribes, row.tribe)) return;
     if (!matchesFilter(selectedPods, row.pod)) return;
     if (!matchesFilter(selectedChapLeads, row.aeChapLeadR)) return;
     if (!matchesFilter(selectedNwobTypes, nwobType)) return;

     const rRole = getEffectiveRole(row.roleL, row.roleH);
     if (selectedRoles && selectedRoles.length > 0) {
       const roleMatch = selectedRoles.some(r => r === rRole || r === row.roleL || r === row.roleH);
       if (!roleMatch) return;
     }

     if (row.pod && row.pod !== '-') {
       const cat = normalize(catQ) === 'bau' ? 'BAU' : 'POD';
       if (!podCategoryMap[row.pod]) {
         podCategoryMap[row.pod] = cat;
       }
     }
   });

   let podCount = 0;
   let bauCount = 0;
   Object.keys(podCategoryMap).forEach(podName => {
     if (podCategoryMap[podName] === 'BAU') {
       bauCount++;
     } else {
       podCount++;
     }
   });

   const totalUniquePods = podCount + bauCount;

   const uniquePods = [...new Set(rows.map(row => row.pod))].sort((a, b) => a.localeCompare(b));
   const activeByRole = {};

   headcountRows.forEach(row => {
     if (isTBD(row.resource)) return;
     const role = row.effective_role;
     activeByRole[role] = (activeByRole[role] || 0) + row.allocation;
   });

   const activeRounded = {};
   Object.keys(activeByRole).forEach(role => {
     activeRounded[role] = roundHalfUp(activeByRole[role]);
   });

   const allRoles = [...new Set([...Object.keys(activeByRole), ...Object.keys(forHireByRole)])]
     .sort((a, b) => roleRank(a) - roleRank(b) || a.localeCompare(b));

   const roleHeadcountSummary = allRoles.map(role => ({
     role,
     active_resources: activeRounded[role] || 0,
     to_be_hired: round2(forHireByRole[role] ? forHireByRole[role].headcount : 0)
   }));

   resourceAssignments.sort((a, b) =>
     a.tribe.localeCompare(b.tribe) ||
     a.resource.localeCompare(b.resource) ||
     roleRank(a.role) - roleRank(b.role) ||
     a.role.localeCompare(b.role) ||
     a.pod.localeCompare(b.pod)
   );

   const completeCount = podCards.filter(card => card.target_met).length;

   const activeResExact = headcountRows.filter(r => !isTBD(r.resource)).reduce((sum, r) => sum + r.allocation, 0);

   return {
     metrics: {
       total_resources: roundHalfUp(allocationTotal),
       total_active_resources: roundHalfUp(activeResExact),
       total_assignments: rows.length,
       total_pods: uniquePods.length,
       total_unique_pods: totalUniquePods,
       pod_type_count: podCount,
       bau_type_count: bauCount,
       total_for_hire: round2(forHireTotal),
       total_organic: roundHalfUp(totalOrg),
       total_inorganic: roundHalfUp(totalInorg),
       active_organic: roundHalfUp(activeOrg),
       active_inorganic: roundHalfUp(activeInorg),
       for_hire_organic: round2(forHireOrg),
       for_hire_inorganic: round2(forHireInorg),
       total_lead_builders: roundHalfUp(totalLeadBuilders),
       total_builders: roundHalfUp(totalBuilders)
     },
     role_headcount_summary: roleHeadcountSummary,
     role_headcount_totals: { active_resources: roundHalfUp(activeResExact), to_be_hired: round2(forHireTotal) },
     for_hire_role_breakdown: Object.keys(forHireByRole)
       .sort((a, b) => roleRank(a) - roleRank(b) || a.localeCompare(b))
       .map(role => ({
         role,
         headcount: round2(forHireByRole[role].headcount),
         pod_assignments: Object.keys(forHireByRole[role].pods).sort()
       })),
     resource_assignments: resourceAssignments,
     pod_list: uniquePods,
     pod_raw_rows: rows,
     builder_summary: {
       target_lead: 1,
       target_builder: 2,
       pods_meeting_target: completeCount,
       pods_needing_attention: podCards.length - completeCount,
       total_pods: podCards.length
     },
     pod_cards: podCards,
     bau_cards: bauCards
   };
 }

