 function renderResourceTable() {
   const rows = (activeDashboardData.resource_assignments || []).slice();

   const roles = [...new Set(rows.map(row => row.role))].sort((a, b) => roleRank(a) - roleRank(b) || a.localeCompare(b));
   const pods = [...new Set(rows.map(row => row.pod))].sort((a, b) => a.localeCompare(b));

   const roleFilter = document.getElementById('role-filter');
   const podFilter = document.getElementById('pod-assignment-filter');
   const nameFilter = document.getElementById('resource-name-filter');

   roleFilter.innerHTML = '<option value="all">All Roles</option>' + roles.map(role => `<option value="${esc(role)}">${esc(role)}</option>`).join('');
   podFilter.innerHTML = '<option value="all">All PODs</option>' + pods.map(pod => `<option value="${esc(pod)}">${esc(pod)}</option>`).join('');

   function draw() {
     const selectedRole = roleFilter.value;
     const selectedPod = podFilter.value;
     const nameSearch = nameFilter.value.toLowerCase().trim();

     const visible = rows.filter(row => {
       const matchesRole = selectedRole === 'all' || row.role === selectedRole;
       const matchesPod = selectedPod === 'all' || row.pod === selectedPod;
       const matchesName = !nameSearch || row.resource.toLowerCase().includes(nameSearch);
       return matchesRole && matchesPod && matchesName;
     });

     const totalAllocationVal = visible.reduce((sum, row) => sum + (Number(row.allocation) || 0), 0);

     document.getElementById('resource-allocation-summary').innerHTML = `
       <div class="header-count-badge" style="display: inline-flex; align-items: center; gap: 8px;">
         <span>TOTAL ALLOCATION:</span>
         <strong style="color: var(--text-main); font-size: 14px;">${fmtAllocation(totalAllocationVal)} HC</strong>
       </div>
     `;

     document.getElementById('resource-table-total-allocation').textContent = fmtAllocation(totalAllocationVal) + ' HC';

     if (!visible.length) {
       document.getElementById('resource-table').innerHTML = '<tr><td colspan="5" class="empty">No matching resources found.</td></tr>';
       return;
     }

     let html = '';
     let i = 0;

     while (i < visible.length) {
       const current = visible[i];
       let span = 1;

       while (
         i + span < visible.length &&
         visible[i + span].tribe === current.tribe &&
         visible[i + span].resource === current.resource &&
         visible[i + span].role === current.role
       ) {
         span++;
       }

       for (let j = 0; j < span; j++) {
         const row = visible[i + j];
         html += '<tr>';
         if (j === 0) {
           const rowspanAttr = span > 1 ? ` rowspan="${span}"` : '';
           html += `<td${rowspanAttr}>${esc(current.tribe)}</td>`;
           html += `<td${rowspanAttr}>${esc(current.resource)}</td>`;
           html += `<td${rowspanAttr}>${esc(current.role)}</td>`;
         }
         html += `<td>${esc(row.pod)}</td>`;
         html += `<td class="num">${fmtAllocation(row.allocation)}</td>`;
         html += '</tr>';
       }

       i += span;
     }

     document.getElementById('resource-table').innerHTML = html;
   }

   roleFilter.onchange = draw;
   podFilter.onchange = draw;
   nameFilter.oninput = draw;
   draw();
 }

