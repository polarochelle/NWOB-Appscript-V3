 /* --- GENERAL STRUCTURE RENDERER (100% STRICT EXACT ROLE MATCHING FOR ALL LEADERSHIP / CHAPTER LEAD ROLES) --- */
 function renderGeneralStructure(selectedTribes) {
   const container = document.getElementById('general-structure-container');
   const tribesList = Array.isArray(selectedTribes) ? selectedTribes : [selectedTribes];

   let html = '';

   tribesList.forEach(selectedTribe => {
     const tribeRows = (rawData.rawRows || []).filter(r => r.tribe === selectedTribe);
     if (!tribeRows.length) return;

     const isDataTribe = normalize(selectedTribe) === 'data tribe';

     const aeGroups = {};
     tribeRows.forEach(r => {
       const aeLead = clean(r.aeChapLeadR);
       const podName = clean(r.pod);

       if (!aeLead || aeLead.toUpperCase() === 'N/A' || aeLead.toUpperCase() === 'NOT APPLICABLE' || aeLead === '-') return;

       if (!aeGroups[aeLead]) aeGroups[aeLead] = new Set();
       
       if (podName && podName !== '-' && podName.toUpperCase() !== 'N/A') {
         aeGroups[aeLead].add(podName);
       }
     });

     const aeLeads = Object.keys(aeGroups).filter(ae => aeGroups[ae].size > 0);
     const colCount = aeLeads.length || 1;

     // STRICT LOOKUP: EXACT CASE-INSENSITIVE EQUALITY MATCH ON COLUMN H (ROLE) OR COLUMN L (NEW NWOB ROLE)
     const getRoleByTribeAndSourceRole = (exactRoleName) => {
       const targetLower = exactRoleName.toLowerCase().trim();

       const found = tribeRows.find(r => {
         const nwob = (r.roleL || '').toLowerCase().trim();
         const source = (r.roleH || '').toLowerCase().trim();
         return nwob === targetLower || source === targetLower;
       });

       if (!found) return '—';
       const res = clean(found.resource);
       return (!res || res.toUpperCase() === 'N/A') ? '—' : res;
     };

     const rolesList = [
       { label: 'Tribe Lead', exact: 'Tribe Lead' },
       { label: 'Scrum Master Chapter Lead', exact: 'Scrum Master Chapter Lead' },
       { label: 'Solutions Designer Chapter Lead', exact: 'Solutions Designer Chapter Lead' },
       { label: 'Quality Assurance Chapter Lead', exact: 'Quality Assurance Chapter Lead' },
       { label: 'Portfolio Manager', exact: 'Portfolio Manager' },
       { label: 'Agile Coach', exact: 'Agile Coach' },
       { label: 'Platform Manager', exact: 'Platform Manager' },
       { label: 'Delivery Change Analyst', exact: 'Delivery Change Analyst' },
       { label: 'Delivery Change Manager', exact: 'Delivery Change Manager' },
       { label: 'Data Engineer Chapter Lead', exact: 'Data Engineer Chapter Lead' }
     ];

     if (!isDataTribe) {
       const des = [...new Set(tribeRows.filter(r => (r.roleL || '').toLowerCase().trim() === 'data engineer' || (r.roleH || '').toLowerCase().trim() === 'data engineer').map(r => r.resource).filter(res => res && res.toUpperCase() !== 'N/A'))];
       const das = [...new Set(tribeRows.filter(r => (r.roleL || '').toLowerCase().trim() === 'data analyst' || (r.roleH || '').toLowerCase().trim() === 'data analyst').map(r => r.resource).filter(res => res && res.toUpperCase() !== 'N/A'))];

       rolesList.push({ 
         label: 'Data Engineer', 
         value: des.length > 0 ? des.join(' / ') : '—' 
       });

       rolesList.push({ 
         label: 'Data Analyst', 
         value: das.length > 0 ? das.join(' / ') : '—' 
       });
     }

     html += `
       <div class="deck-table-container">
         <table class="deck-table">
           <colgroup>
             <col class="col-role">
             ${'<col>'.repeat(colCount)}
           </colgroup>
           <thead>
             <tr>
               <th colspan="${colCount + 1}" class="tribe-header-banner">${esc(selectedTribe)}</th>
             </tr>
             <tr>
               <th class="role-header-col">Role \\ Squad</th>
               ${
                 aeLeads.length > 0 
                   ? aeLeads.map(ae => `
                       <td class="pod-group-box">
                         <ul>
                           ${Array.from(aeGroups[ae]).map(pod => `<li>${esc(pod)}</li>`).join('')}
                         </ul>
                       </td>
                     `).join('')
                   : `<td class="pod-group-box">—</td>`
               }
             </tr>
           </thead>
           <tbody>
     `;

     rolesList.slice(0, 4).forEach(r => {
       const val = r.value !== undefined ? r.value : getRoleByTribeAndSourceRole(r.exact);
       html += `
         <tr>
           <th class="role-header-col">${esc(r.label)}</th>
           <td colspan="${colCount}" class="merged-val-cell">${esc(val)}</td>
         </tr>
       `;
     });

     if (aeLeads.length > 0) {
       html += `
         <tr>
           <th class="role-header-col">A&amp;E Chapter Lead</th>
           ${aeLeads.map(ae => `<td class="merged-val-cell">${esc(ae)}</td>`).join('')}
         </tr>
       `;
     } else {
       html += `
         <tr>
           <th class="role-header-col">A&amp;E Chapter Lead</th>
           <td colspan="${colCount}" class="merged-val-cell">—</td>
       </tr>
       `;
     }

     rolesList.slice(4).forEach(r => {
       const val = r.value !== undefined ? r.value : getRoleByTribeAndSourceRole(r.exact);
       html += `
         <tr>
           <th class="role-header-col">${esc(r.label)}</th>
           <td colspan="${colCount}" class="merged-val-cell">${esc(val)}</td>
         </tr>
       `;
     });

     html += `
           </tbody>
         </table>
       </div>
     `;
   });

   container.innerHTML = html || '<div class="empty">No General Structure data available.</div>';
 }

 /* --- A&E SPECIFIC STRUCTURE RENDERER (DYNAMIC BUILDERS + PRODUCT OWNER INCLUDED HERE) --- */
 function renderAEStructure(selectedTribes) {
   const container = document.getElementById('ae-structure-container');
   const tribesList = Array.isArray(selectedTribes) ? selectedTribes : [selectedTribes];

   let html = '';

   tribesList.forEach(selectedTribe => {
     const tribeRows = (rawData.rawRows || []).filter(r => r.tribe === selectedTribe);
     const isDataTribe = normalize(selectedTribe) === 'data tribe';

     const aeMap = {};
     tribeRows.forEach(r => {
       const aeLead = clean(r.aeChapLeadR);
       const podName = clean(r.pod);

       if (!aeLead || aeLead.toUpperCase() === 'N/A' || aeLead.toUpperCase() === 'NOT APPLICABLE' || aeLead === '-') return;

       if (!aeMap[aeLead]) aeMap[aeLead] = {};
       if (podName && podName !== '-' && podName.toUpperCase() !== 'N/A') {
         if (!aeMap[aeLead][podName]) aeMap[aeLead][podName] = [];
         aeMap[aeLead][podName].push(r);
       }
     });

     const aeLeads = Object.keys(aeMap);

     aeLeads.forEach(aeLead => {
       const pods = Object.keys(aeMap[aeLead]).sort();
       if (!pods.length) return;

       const colCount = pods.length;
       
       let maxBuilders = 2;
       pods.forEach(podName => {
         const rows = aeMap[aeLead][podName];
         const count = rows.filter(r => r.roleL.toLowerCase().includes('builder') && !r.roleL.toLowerCase().includes('lead')).length;
         if (count > maxBuilders) {
           maxBuilders = count;
         }
       });

       const roles = [
         { key: 'sm', label: 'Scrum Master', query: 'scrum master' },
         { key: 'sd', label: 'Solutions Designer', query: 'solutions designer' },
         { key: 'qa', label: 'Quality Assurance Lead', query: 'quality assurance' },
         { key: 'lb', label: 'Lead Builder', query: 'lead builder' }
       ];

       for (let b = 1; b <= maxBuilders; b++) {
         roles.push({ key: `b${b}`, label: `Builder ${b}`, isBuilder: true, builderIndex: b - 1 });
       }

       if (isDataTribe) {
         roles.push({ key: 'de', label: 'Data Engineer', query: 'data engineer' });
         roles.push({ key: 'da', label: 'Data Analyst', query: 'data analyst' });
       }

       roles.push({ key: 'pe', label: 'Platform Engineer', query: 'platform engineer' });
       
       // PRODUCT OWNER IN A&E SPECIFIC STRUCTURE
       roles.push({ key: 'po', label: 'Product Owner', query: 'product owner' });

       const matrix = {};
       roles.forEach(r => { matrix[r.key] = []; });

       pods.forEach(podName => {
         const rows = aeMap[aeLead][podName];
         const builders = rows.filter(r => r.roleL.toLowerCase().includes('builder') && !r.roleL.toLowerCase().includes('lead'));

         roles.forEach(roleObj => {
           if (roleObj.isBuilder) {
             const bResource = builders[roleObj.builderIndex] ? builders[roleObj.builderIndex].resource : 'N/A';
             matrix[roleObj.key].push(bResource);
           } else {
             const match = rows.find(r => r.roleL.toLowerCase().includes(roleObj.query) || r.roleH.toLowerCase().includes(roleObj.query));
             matrix[roleObj.key].push(match ? match.resource : 'N/A');
           }
         });
       });

       html += `
         <div class="deck-table-container">
           <table class="deck-table">
             <colgroup>
               <col class="col-role">
               ${'<col>'.repeat(colCount)}
             </colgroup>
             <thead>
               <tr>
                 <th colspan="${colCount + 1}" class="tribe-header-banner">${esc(selectedTribe)}</th>
               </tr>
               <tr>
                 <th class="role-header-col">Role \\ Squad</th>
                 ${pods.map(p => `<td class="pod-item-header">${esc(p)}</td>`).join('')}
               </tr>
               <tr>
                 <th class="role-header-col">A &amp; E Chapter Lead</th>
                 <td colspan="${colCount}" class="merged-val-cell">${esc(aeLead)}</td>
               </tr>
             </thead>
             <tbody>
               ${roles.map(r => {
                 const rowVals = matrix[r.key];
                 let rowCellsHtml = '';
                 let i = 0;

                 while (i < rowVals.length) {
                   let span = 1;
                   while (i + span < rowVals.length && rowVals[i + span] === rowVals[i] && rowVals[i] !== 'N/A') {
                     span++;
                   }

                   const val = rowVals[i];
                   const isEmpty = val === 'N/A' || val === 'TBD' || !val;
                   const cellClass = isEmpty ? 'empty-cell' : 'merged-val-cell';
                   const colspanAttr = span > 1 ? ` colspan="${span}"` : '';

                   rowCellsHtml += `<td${colspanAttr} class="${cellClass}">${esc(val)}</td>`;
                   i += span;
                 }

                 return `
                   <tr>
                     <th class="role-header-col">${esc(r.label)}</th>
                     ${rowCellsHtml}
                   </tr>
                 `;
               }).join('')}
             </tbody>
           </table>
         </div>
       `;
     });
   });

   container.innerHTML = html || '<div class="empty">No A&E Chapter Lead data available.</div>';
 }

