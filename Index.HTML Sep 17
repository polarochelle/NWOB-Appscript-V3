         <div class="assignment">
           <span class="assignment-name">
             <span>${esc(row.resource)}</span>${pillHtml}
           </span>
           <span class="assignment-role">${esc(row.role_h)} · ${fmtAllocation(allocation)} HC</span>
         </div>
       `;
     }).join('');

   return `
     <article class="pod-card ${statusClass}">
       <div class="pod-header" style="margin-bottom: 12px;">
         <div>
           <div class="pod-name">${esc(bau.pod)}</div>
           <div class="pod-tribe">${esc(bau.tribe)}</div>
         </div>
         <span class="status ${statusClass}">${complete ? 'BAU Complete' : 'BAU Incomplete'}</span>
       </div>
       <div class="assignments">${assignments}</div>
     </article>
   `;
 }

 function renderPods() {
   const search = document.getElementById('pod-search').value.toLowerCase().trim();
   const status = document.getElementById('status-filter').value;

   const pods = (activeDashboardData.pod_cards || []).filter(pod => {
     const matchesSearch = !search || pod.pod.toLowerCase().includes(search) || pod.assignments.some(row => row.resource.toLowerCase().includes(search));
     const matchesStatus = status === 'all' || (status === 'complete' && isPodComplete(pod)) || (status === 'incomplete' && !isPodComplete(pod));
     return matchesSearch && matchesStatus;
   });

   const complete = pods.filter(pod => isPodComplete(pod));
   const incomplete = pods.filter(pod => !isPodComplete(pod));

   document.getElementById('complete-grid').innerHTML = complete.length ? complete.map(renderPodCard).join('') : '<div class="empty">No PODs found.</div>';
   document.getElementById('incomplete-grid').innerHTML = incomplete.length ? incomplete.map(renderPodCard).join('') : '<div class="empty">No PODs found.</div>';
   document.getElementById('complete-count').textContent = ` (${complete.length})`;
   document.getElementById('incomplete-count').textContent = ` (${incomplete.length})`;
 }

 function renderBaus() {
   const search = document.getElementById('bau-search').value.toLowerCase().trim();
   const status = document.getElementById('bau-status-filter').value;

   const baus = (activeDashboardData.bau_cards || []).filter(bau => {
     const matchesSearch = !search || bau.pod.toLowerCase().includes(search) || bau.assignments.some(row => row.resource.toLowerCase().includes(search));
     const matchesStatus = status === 'all' || (status === 'complete' && bau.target_met) || (status === 'incomplete' && !bau.target_met);
     return matchesSearch && matchesStatus;
   });

   const complete = baus.filter(b => b.target_met);
   const incomplete = baus.filter(b => !b.target_met);

   document.getElementById('bau-complete-grid').innerHTML = complete.length ? complete.map(renderBauCard).join('') : '<div class="empty">No BAUs found.</div>';
   document.getElementById('bau-incomplete-grid').innerHTML = incomplete.length ? incomplete.map(renderBauCard).join('') : '<div class="empty">No BAUs found.</div>';
   document.getElementById('bau-complete-count').textContent = ` (${complete.length})`;
   document.getElementById('bau-incomplete-count').textContent = ` (${incomplete.length})`;
 }

 function setupAccordionLabels() {
   const bindToggle = (detailsId, textId) => {
     const details = document.getElementById(detailsId);
     const label = document.getElementById(textId);
     if (!details || !label) return;

     const updateText = () => {
       label.textContent = details.open ? 'Click to collapse' : 'Click to expand';
     };

     details.addEventListener('toggle', updateText);
     updateText();
   };

   bindToggle('condition-details-el', 'condition-summary-state');
   bindToggle('complete-group', 'complete-state');
   bindToggle('incomplete-group', 'incomplete-state');
   bindToggle('bau-condition-details-el', 'bau-condition-summary-state');
   bindToggle('bau-complete-group', 'bau-complete-state');
   bindToggle('bau-incomplete-group', 'bau-incomplete-state');
 }

